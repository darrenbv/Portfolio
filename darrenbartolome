<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="description" content="Darren Bartolome Victorino — interactive full-screen portfolio. Banking, risk, compliance, process automation and digital transformation specialist.">
<meta name="theme-color" content="#fffefb">
<title>Darren Bartolome Victorino · Interactive Portfolio</title>
<!-- SELF-CONTAINED: no external requests. Spacing fixed in CSS so nothing overlaps. -->
<style>
:root{
  --bg:#05070d;--bg-2:#080b16;
  --panel:rgba(20,26,42,.55);--panel-solid:#0e1424;
  --stroke:rgba(150,175,220,.14);--stroke-str:rgba(150,175,220,.28);
  --ink:#f2f6ff;--soft:#9aa6be;--faint:#626d84;
  --a1:#3df0d0;--a2:#5b8cff;--a3:#b98cff;--a4:#ffb454;--a5:#4be79b;
  --grad:linear-gradient(120deg,var(--a1),var(--a2) 55%,var(--a3));
  --glow:0 0 40px rgba(59,240,208,.18);
  --r-lg:26px;--r-md:18px;--r-sm:12px;
  --ease:cubic-bezier(.16,.84,.34,1);
  --ease-io:cubic-bezier(.65,0,.35,1);
  --ease-book:cubic-bezier(.42,.04,.28,1);
  --pad:clamp(26px,5vw,84px);
  --top-clear:132px;--bottom-clear:140px;
}
body.light{
  --bg:#fffefb;--bg-2:#f8f4f0;
  --panel:rgba(255,255,255,.86);--panel-solid:#ffffff;
  --stroke:rgba(32,21,21,.12);--stroke-str:rgba(32,21,21,.26);
  --ink:#201515;--soft:#605d52;--faint:#939084;
  --a1:#ff4f00;--a2:#ff6a2b;--a3:#2b2358;
  --grad:linear-gradient(120deg,#ff4f00,#ff7a33 72%);
  --glow:0 0 34px rgba(255,79,0,.16);
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;width:100%;overflow:hidden}
body{font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Inter,Arial,sans-serif;color:var(--ink);background:var(--bg);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;transition:background .4s ease,color .4s ease}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;cursor:pointer;border:none;background:none;-webkit-tap-highlight-color:transparent}
:focus-visible{outline:2px solid var(--a2);outline-offset:3px;border-radius:6px}

.ambient{position:fixed;inset:0;z-index:0;overflow:hidden;pointer-events:none}
.ambient::before,.ambient::after{content:"";position:absolute;border-radius:50%;filter:blur(90px);opacity:.5}
.ambient::before{width:52vw;height:52vw;top:-14vw;left:-10vw;background:radial-gradient(circle,rgba(255,79,0,.16),transparent 68%);animation:float1 18s ease-in-out infinite}
.ambient::after{width:46vw;height:46vw;bottom:-16vw;right:-8vw;background:radial-gradient(circle,rgba(255,150,80,.18),transparent 68%);animation:float2 22s ease-in-out infinite}
.grid-overlay{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.5;background-image:linear-gradient(var(--stroke) 1px,transparent 1px),linear-gradient(90deg,var(--stroke) 1px,transparent 1px);background-size:64px 64px;-webkit-mask-image:radial-gradient(circle at 50% 40%,black,transparent 78%);mask-image:radial-gradient(circle at 50% 40%,black,transparent 78%)}
@keyframes float1{0%,100%{transform:translate(0,0)}50%{transform:translate(6vw,4vw)}}
@keyframes float2{0%,100%{transform:translate(0,0)}50%{transform:translate(-5vw,-3vw)}}

.chrome{position:fixed;inset:0;z-index:40;pointer-events:none}
.chrome>*{pointer-events:auto}
.progress{position:absolute;top:0;left:0;height:3px;width:0;background:var(--grad);box-shadow:var(--glow);transition:width .6s var(--ease);z-index:46}

.topbar{position:absolute;top:0;left:0;right:0;z-index:44;transition:padding-left .3s var(--ease);display:flex;align-items:flex-start;justify-content:space-between;gap:14px;padding:18px clamp(18px,4vw,42px);min-height:var(--top-clear)}
.topbar::before{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,var(--bg) 30%,color-mix(in srgb,var(--bg) 55%,transparent) 70%,transparent)}
.brand{position:relative;display:flex;align-items:center;gap:12px;min-width:0;max-width:calc(100% - 116px)}
.brand-mark{flex:0 0 auto;width:42px;height:42px;display:grid;place-items:center;border-radius:12px;background:var(--grad);color:#fff;font-weight:900;letter-spacing:-.04em;box-shadow:var(--glow)}
.brand-txt{min-width:0}
.brand-txt b{display:block;font-size:.95rem;font-weight:800;letter-spacing:-.01em;line-height:1.2;overflow-wrap:anywhere}
.brand-txt span{display:block;font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;color:var(--soft);margin-top:2px}
.tools{position:relative;flex:0 0 auto;display:flex;gap:8px}
.tool{width:42px;height:42px;display:grid;place-items:center;border-radius:11px;border:1px solid var(--stroke);background:var(--panel);color:var(--ink);font-size:1rem;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);transition:transform .2s var(--ease),border-color .2s ease,background .2s ease}
.tool:hover{transform:translateY(-2px);border-color:var(--stroke-str)}
.tool svg{width:18px;height:18px;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round}

/* GLOBAL LINKEDIN CONTROL — fixed in the header and visible on all pages */
.linkedin-global{display:flex;align-items:center;height:42px;border-radius:12px;overflow:hidden;background:color-mix(in srgb,var(--panel-solid) 90%,transparent);border:1px solid var(--stroke);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);box-shadow:0 10px 26px rgba(20,20,35,.10);transition:border-color .2s ease,box-shadow .2s ease,transform .2s var(--ease)}
.linkedin-global:hover{border-color:color-mix(in srgb,#0a66c2 48%,var(--stroke));box-shadow:0 14px 32px rgba(10,102,194,.14);transform:translateY(-2px)}
.linkedin-open{height:100%;display:flex;align-items:center;gap:8px;padding:0 12px;color:var(--ink);font-size:.74rem;font-weight:800;white-space:nowrap}
.linkedin-open svg{width:17px;height:17px;fill:#0a66c2;flex:0 0 auto}
.linkedin-copy{width:36px;height:100%;display:grid;place-items:center;border-left:1px solid var(--stroke);color:var(--faint);transition:background .2s ease,color .2s ease}
.linkedin-copy:hover{background:color-mix(in srgb,#0a66c2 10%,transparent);color:#0a66c2}
.linkedin-copy svg{width:15px;height:15px;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round}
@media (max-width:720px){
  .linkedin-open{width:38px;padding:0;justify-content:center}
  .linkedin-open span{display:none}
  .linkedin-copy{width:34px}
}
.rail{display:none !important}

/* MODERN COMPACT SECTION NAVIGATION — fixed at the original middle-left location */
.dock-toggle{
  position:absolute;top:50%;left:clamp(14px,1.6vw,24px);transform:translateY(-50%);z-index:45;
  display:flex;align-items:center;gap:10px;height:46px;padding:6px 13px 6px 6px;
  border-radius:15px;background:color-mix(in srgb,var(--panel-solid) 90%,transparent);
  border:1px solid color-mix(in srgb,var(--ink) 12%,transparent);color:var(--ink);
  backdrop-filter:blur(22px) saturate(1.3);-webkit-backdrop-filter:blur(22px) saturate(1.3);
  box-shadow:0 14px 34px rgba(20,20,35,.14),inset 0 1px 0 rgba(255,255,255,.5);
  transition:transform .22s var(--ease),border-color .22s ease,box-shadow .22s ease
}
.dock-toggle::after{content:"";width:6px;height:6px;margin-left:2px;border-right:1.7px solid var(--faint);border-bottom:1.7px solid var(--faint);transform:rotate(45deg) translateY(-2px);transition:transform .22s var(--ease),border-color .22s ease}
.dock-toggle:hover{transform:translateY(-50%) translateX(3px);border-color:color-mix(in srgb,var(--a1) 45%,transparent);box-shadow:0 18px 42px rgba(20,20,35,.18),0 0 0 3px color-mix(in srgb,var(--a1) 7%,transparent)}
.dock-toggle[aria-expanded="true"]::after{transform:rotate(225deg) translate(-1px,-1px);border-color:var(--a1)}
.dock-toggle .ico{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:var(--grad);color:#fff;box-shadow:0 8px 18px color-mix(in srgb,var(--a1) 22%,transparent)}
.dock-toggle .ico svg{width:17px;height:17px;stroke:currentColor;stroke-width:2.2;fill:none;stroke-linecap:round;stroke-linejoin:round}
.dock-toggle .cur{display:flex;align-items:center;gap:7px;white-space:nowrap;text-align:left}
.dock-toggle .cur::before{content:"Sections";font-size:.74rem;font-weight:850;letter-spacing:.01em;color:var(--ink)}
.dock-toggle .cur #toggleName{display:none}
.dock-toggle .cur em{font-style:normal;color:var(--faint);font-size:.65rem;font-weight:750;letter-spacing:.02em}

.dock{
  position:absolute;top:50%;left:clamp(14px,1.6vw,24px);z-index:46;
  display:flex;flex-direction:column;gap:3px;width:218px;max-height:calc(100vh - 36px);
  padding:12px;border-radius:18px;overflow-y:auto;
  background:color-mix(in srgb,var(--panel-solid) 94%,transparent);
  border:1px solid color-mix(in srgb,var(--ink) 11%,transparent);
  backdrop-filter:blur(28px) saturate(1.4);-webkit-backdrop-filter:blur(28px) saturate(1.4);
  box-shadow:0 24px 70px rgba(15,20,35,.22),inset 0 1px 0 rgba(255,255,255,.5);
  opacity:0;visibility:hidden;pointer-events:none;transform:translateY(-50%) translateX(-8px) scale(.98);transform-origin:left center;
  transition:opacity .18s ease,transform .22s var(--ease),visibility .18s
}
.dock.open{opacity:1;visibility:visible;pointer-events:auto;transform:translateY(-50%) translateX(0) scale(1)}
.dock::-webkit-scrollbar{width:5px}.dock::-webkit-scrollbar-thumb{background:var(--stroke-str);border-radius:9px}
.dock-head{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:2px 3px 10px 8px;margin-bottom:3px;border-bottom:1px solid var(--stroke)}
.dock-title{display:flex;align-items:center;gap:8px;color:var(--faint);font-size:.58rem;font-weight:900;letter-spacing:.17em;text-transform:uppercase}
.dock-title::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--a1);box-shadow:0 0 0 4px color-mix(in srgb,var(--a1) 11%,transparent)}
.dock-close{width:28px;height:28px;display:grid;place-items:center;border-radius:9px;color:var(--faint);transition:color .18s ease,background .18s ease}
.dock-close:hover{color:var(--ink);background:var(--stroke)}
.dock-close svg{width:13px;height:13px;stroke:currentColor;stroke-width:2.3;fill:none;stroke-linecap:round}
.dock-item{position:relative;display:grid;grid-template-columns:28px 1fr;align-items:center;gap:10px;width:100%;padding:8px;border-radius:11px;color:var(--soft);text-align:left;transition:background .18s ease,color .18s ease,transform .18s var(--ease)}
.dock-item .num{width:28px;height:28px;display:grid;place-items:center;border-radius:8px;background:var(--stroke);color:var(--faint);font-size:.61rem;font-weight:850;transition:background .18s ease,color .18s ease,box-shadow .18s ease}
.dock-item .txt{font-size:.78rem;font-weight:720;white-space:nowrap}
.dock-item:hover{background:color-mix(in srgb,var(--a1) 8%,transparent);color:var(--ink);transform:translateX(2px)}
.dock-item.on{background:color-mix(in srgb,var(--a1) 11%,transparent);color:var(--ink)}
.dock-item.on .num{background:var(--grad);color:#fff;box-shadow:0 7px 16px color-mix(in srgb,var(--a1) 20%,transparent)}
.dock-item.on::after{content:"";position:absolute;right:9px;width:5px;height:5px;border-radius:50%;background:var(--a1)}}

.dock{position:absolute;top:50%;left:clamp(16px,1.8vw,28px);transform:translateY(-50%) scale(.96);transform-origin:left center;z-index:46;display:flex;flex-direction:column;gap:3px;padding:12px 12px 13px;width:190px;border-radius:20px;background:var(--panel);border:1px solid var(--stroke);backdrop-filter:blur(22px) saturate(1.2);-webkit-backdrop-filter:blur(22px) saturate(1.2);box-shadow:0 26px 64px -18px rgba(20,40,80,.32),inset 0 1px 0 rgba(255,255,255,.35);opacity:0;visibility:hidden;pointer-events:none;transition:opacity .2s var(--ease),transform .2s var(--ease),visibility .2s;max-height:calc(100vh - 40px);overflow-y:auto}
.dock.open{opacity:1;visibility:visible;pointer-events:auto;transform:translateY(-50%) scale(1)}
.dock::-webkit-scrollbar{width:6px}.dock::-webkit-scrollbar-thumb{background:var(--stroke-str);border-radius:9px}
.dock-head{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:4px 6px 10px 12px}
.dock-title{display:flex;align-items:center;gap:8px;color:var(--faint);font-size:.56rem;font-weight:850;letter-spacing:.2em;text-transform:uppercase}
.dock-title::before{content:"";width:14px;height:2px;border-radius:9px;background:var(--grad)}
.dock-close{flex:0 0 auto;width:24px;height:24px;display:grid;place-items:center;border-radius:8px;color:var(--faint);border:1px solid var(--stroke);transition:color .2s ease,border-color .2s ease}
.dock-close:hover{color:var(--ink);border-color:var(--stroke-str)}
.dock-close svg{width:13px;height:13px;stroke:currentColor;stroke-width:2.4;fill:none;stroke-linecap:round}
.dock-item{position:relative;display:flex;align-items:center;gap:12px;padding:8px 12px;border-radius:12px;color:var(--soft);text-align:left;transition:background .22s var(--ease),color .22s var(--ease),transform .22s var(--ease)}
.dock-item .num{flex:0 0 auto;width:24px;height:24px;display:grid;place-items:center;border-radius:8px;background:var(--stroke);color:var(--faint);font-size:.62rem;font-weight:850;letter-spacing:-.02em;transition:all .22s var(--ease)}
.dock-item .txt{font-size:.8rem;font-weight:700;letter-spacing:-.01em;white-space:nowrap}
.dock-item:hover{background:color-mix(in srgb,var(--a1) 12%,transparent);color:var(--ink);transform:translateX(3px)}
.dock-item:hover .num{background:color-mix(in srgb,var(--a1) 22%,transparent);color:var(--a1)}
.dock-item.on{background:color-mix(in srgb,var(--a1) 10%,transparent);color:var(--ink)}
.dock-item.on .num{background:var(--grad);color:#fff;box-shadow:var(--glow)}
.dock-item.on::before{content:"";position:absolute;left:-12px;top:50%;transform:translateY(-50%);width:3px;height:20px;border-radius:9px;background:var(--grad)}

.controls{position:absolute;bottom:0;left:0;right:0;z-index:44;transition:padding-left .3s var(--ease);display:flex;flex-direction:column;align-items:center;gap:10px;padding:0 22px 20px;pointer-events:none}
.controls>*{pointer-events:auto}
.hint{display:inline-flex;align-items:center;gap:9px;padding:6px 14px;border-radius:999px;background:var(--panel);border:1px solid var(--stroke);color:var(--faint);font-size:.7rem;font-weight:700;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
.hint svg{width:14px;height:14px;stroke:currentColor;stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round}
.hint .sep{width:3px;height:3px;border-radius:50%;background:var(--stroke-str)}
.hint b{color:var(--soft);font-weight:800}
.pager{display:flex;align-items:center;gap:8px;padding:8px;border-radius:999px;background:var(--panel);border:1px solid var(--stroke);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);box-shadow:0 16px 40px -14px rgba(20,40,80,.3)}
.nav{width:46px;height:46px;display:grid;place-items:center;border-radius:50%;background:transparent;border:1px solid var(--stroke);color:var(--ink);font-size:1.15rem;transition:transform .2s var(--ease),border-color .2s ease,background .2s ease,opacity .2s ease}
.nav:hover{transform:scale(1.08);border-color:var(--stroke-str);background:color-mix(in srgb,var(--a1) 10%,transparent)}
.nav:disabled{opacity:.3;cursor:not-allowed;transform:none;background:transparent}
.counter{min-width:96px;text-align:center;font-weight:800;font-size:.9rem;letter-spacing:.02em}
.counter #cur{color:var(--a1)}
.counter em{font-style:normal;color:var(--faint);font-weight:600}

.flip-zone{position:absolute;top:var(--top-clear);bottom:var(--bottom-clear);z-index:36;width:clamp(72px,9vw,150px);display:flex;align-items:center;cursor:pointer;background:transparent;transition:opacity .3s ease}
.flip-left{left:0;justify-content:flex-start;padding-left:clamp(10px,1.6vw,22px)}
.flip-right{right:0;justify-content:flex-end;padding-right:clamp(10px,1.6vw,22px)}
.flip-zone.off{opacity:0;pointer-events:none}
.flip-zone::before{content:"";position:absolute;top:0;bottom:0;width:100%;opacity:0;transition:opacity .3s ease}
.flip-right::before{right:0;background:linear-gradient(270deg,rgba(255,79,0,.10),transparent)}
.flip-left::before{left:0;background:linear-gradient(90deg,rgba(122,82,230,.10),transparent)}
.flip-zone:hover::before{opacity:1}
.arrow{position:relative;z-index:1;width:54px;height:54px;display:grid;place-items:center;border-radius:50%;background:var(--panel);border:1px solid var(--stroke);color:var(--ink);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);box-shadow:0 12px 30px rgba(20,40,80,.16);opacity:.4;transform:scale(.86);transition:opacity .25s var(--ease),transform .25s var(--ease),border-color .25s ease,box-shadow .25s ease}
.arrow svg{width:22px;height:22px;stroke:currentColor;stroke-width:2.4;fill:none;stroke-linecap:round;stroke-linejoin:round}
.flip-zone:hover .arrow{opacity:1;transform:scale(1);border-color:var(--stroke-str);box-shadow:0 14px 34px rgba(20,40,80,.2),var(--glow)}
.flip-zone:active .arrow{transform:scale(.94)}

.deck{position:absolute;inset:0;z-index:10;overflow:hidden;perspective:2200px;perspective-origin:0% 50%;transition:left .3s var(--ease),filter .3s ease}
/* When the section drawer opens, the portfolio canvas moves aside instead of being covered. */
body.dock-open .deck{left:244px}
body.dock-open .controls{padding-left:244px}
body.dock-open .topbar{padding-left:calc(clamp(18px,4vw,42px) + 244px)}
.page{position:absolute;inset:0;display:grid;align-content:start;padding:var(--top-clear) var(--pad) var(--bottom-clear);overflow-y:auto;overflow-x:hidden;opacity:0;visibility:hidden;transform-origin:left center;backface-visibility:hidden;will-change:transform,opacity}
#p0,#p8{align-content:center;justify-items:center;text-align:center}
.page.active{opacity:1;visibility:visible;z-index:2;transform:rotateY(0deg)}
.page.hold{opacity:1;visibility:visible;z-index:1;transform:rotateY(0deg)}
.page.flip-out{opacity:1;visibility:visible;z-index:6;transform-origin:left center;animation:leafOut .9s var(--ease-book) forwards}
.page.flip-in{opacity:1;visibility:visible;z-index:6;transform-origin:left center;animation:leafIn .9s var(--ease-book) forwards}
@keyframes leafOut{0%{transform:rotateY(0deg)}100%{transform:rotateY(-180deg)}}
@keyframes leafIn{0%{transform:rotateY(-180deg)}100%{transform:rotateY(0deg)}}
.page.flip-out::before,.page.flip-in::before{content:"";position:absolute;inset:0;pointer-events:none;z-index:5;background:linear-gradient(90deg,rgba(15,35,75,.04),rgba(15,35,75,.20) 55%,rgba(8,22,55,.4))}
.page.flip-out::before{animation:sheetOut .9s var(--ease-book) forwards}
.page.flip-in::before{animation:sheetIn .9s var(--ease-book) forwards}
@keyframes sheetOut{0%{opacity:0}45%{opacity:1}100%{opacity:0}}
@keyframes sheetIn{0%{opacity:0}55%{opacity:1}100%{opacity:0}}
.page.active::after{content:"";position:absolute;top:0;bottom:0;left:0;width:70px;pointer-events:none;z-index:0;background:linear-gradient(90deg,rgba(24,52,104,.12),transparent)}
.page::-webkit-scrollbar{width:8px}.page::-webkit-scrollbar-thumb{background:var(--stroke-str);border-radius:10px}

.page.active .stagger>*{animation:rise .6s var(--ease-io) both}
.page.active .stagger>*:nth-child(1){animation-delay:.30s}
.page.active .stagger>*:nth-child(2){animation-delay:.37s}
.page.active .stagger>*:nth-child(3){animation-delay:.44s}
.page.active .stagger>*:nth-child(4){animation-delay:.51s}
.page.active .stagger>*:nth-child(5){animation-delay:.58s}
.page.active .stagger>*:nth-child(6){animation-delay:.65s}
@keyframes rise{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}

.kicker{display:inline-flex;align-items:center;gap:9px;color:var(--a1);font-size:.72rem;font-weight:800;letter-spacing:.2em;text-transform:uppercase}
.kicker::before{content:"";width:26px;height:2px;border-radius:9px;background:var(--a1);box-shadow:var(--glow)}
.h1{font-size:clamp(2.4rem,6vw,5.4rem);line-height:.94;letter-spacing:-.055em;font-weight:800}
.h2{font-size:clamp(1.9rem,4.4vw,3.4rem);line-height:1.0;letter-spacing:-.045em;font-weight:800}
.grad{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.lead{color:var(--soft);font-size:clamp(1rem,1.5vw,1.18rem);max-width:56ch;line-height:1.6}
.glass{background:var(--panel);border:1px solid var(--stroke);border-radius:var(--r-md);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
.chip{display:inline-flex;align-items:center;padding:8px 12px;border:1px solid var(--stroke);border-radius:999px;background:var(--panel);color:var(--soft);font-size:.76rem;font-weight:650;margin:0 8px 8px 0;backdrop-filter:blur(10px)}

.cover-wrap{max-width:960px;display:flex;flex-direction:column;align-items:center}
.badge{display:inline-flex;align-items:center;gap:9px;padding:9px 15px;border:1px solid var(--stroke);border-radius:999px;background:var(--panel);font-size:.72rem;font-weight:750;letter-spacing:.06em;text-transform:uppercase;color:var(--soft);backdrop-filter:blur(12px)}
