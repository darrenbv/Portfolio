<script>
"use strict";
(function(){
  var deck=document.getElementById("deck");
  var pages=Array.prototype.slice.call(deck.querySelectorAll(".page"));
  var total=pages.length, cur=0, busy=false;
  var prev=document.getElementById("prev"), next=document.getElementById("next");
  var curEl=document.getElementById("cur"), totEl=document.getElementById("tot");
  var prog=document.getElementById("progress"), rail=document.getElementById("rail");
  var flipLeft=document.getElementById("flip-left"), flipRight=document.getElementById("flip-right");

  function pad(n){ return (n<10?"0":"")+n; }
  totEl.textContent=pad(total);
  var y=document.getElementById("year"); if(y) y.textContent=new Date().getFullYear();

  pages.forEach(function(p,i){
    var b=document.createElement("button");
    b.type="button"; b.className="railbtn"+(i===0?" on":"");
    b.setAttribute("aria-label","Go to "+(p.getAttribute("data-label")||("page "+(i+1))));
    b.innerHTML='<span class="label">'+(p.getAttribute("data-label")||("0"+(i+1)))+'</span><span class="dot"></span>';
    b.addEventListener("click",function(){ go(i); });
    rail.appendChild(b);
  });
  var railBtns=Array.prototype.slice.call(rail.children);
  var dockItems=Array.prototype.slice.call(document.querySelectorAll(".dock-item"));
  var dock=document.getElementById("dock");
  var dockToggle=document.getElementById("dockToggle");
  var dockClose=document.getElementById("dockClose");
  var toggleName=document.getElementById("toggleName");
  var toggleNum=document.getElementById("toggleNum");

  function chrome(){
    railBtns.forEach(function(b,i){ b.classList.toggle("on", i===cur); });
    dockItems.forEach(function(b){ b.classList.toggle("on", Number(b.getAttribute("data-i"))===cur); });
    curEl.textContent=pad(cur+1);
    prog.style.width=((cur)/(total-1)*100)+"%";
    prev.disabled=cur===0; next.disabled=cur===total-1;
    flipLeft.classList.toggle("off", cur===0);
    flipRight.classList.toggle("off", cur===total-1);
    if(toggleName){ var act=dockItems[cur]; toggleName.textContent=act?act.getAttribute("data-name"):("Page "+(cur+1)); }
    if(toggleNum){ toggleNum.textContent=pad(cur+1)+"/"+pad(total); }
  }

  function openDock(){ if(dock){ dock.classList.add("open"); document.body.classList.add("dock-open"); if(dockToggle) dockToggle.setAttribute("aria-expanded","true"); } }
  function closeDock(){ if(dock){ dock.classList.remove("open"); document.body.classList.remove("dock-open"); if(dockToggle) dockToggle.setAttribute("aria-expanded","false"); } }
  function toggleDock(){ if(dock){ dock.classList.contains("open")?closeDock():openDock(); } }
  if(dockToggle) dockToggle.addEventListener("click", function(e){ e.stopPropagation(); toggleDock(); });
  if(dockClose) dockClose.addEventListener("click", function(e){ e.stopPropagation(); closeDock(); });
  dockItems.forEach(function(b){ b.addEventListener("click", closeDock); });
  document.addEventListener("click", function(e){
    if(!dock || !dock.classList.contains("open")) return;
    if(dock.contains(e.target) || (dockToggle && dockToggle.contains(e.target))) return;
    closeDock();
  });
  document.addEventListener("keydown", function(e){ if(e.key==="Escape") closeDock(); });

  function settle(){
    pages.forEach(function(p,i){ p.classList.remove("flip-out","flip-in","hold"); p.classList.toggle("active", i===cur); });
    pages[cur].scrollTop=0; runCounters();
  }
  function go(i){
    if(busy) return;
    i=Math.max(0,Math.min(total-1,i));
    if(i===cur) return;
    var from=cur, forward=i>from;
    cur=i; busy=true; chrome();
    pages.forEach(function(p){ p.classList.remove("flip-out","flip-in","hold"); });
    if(forward){ pages[i].classList.add("active"); pages[from].classList.remove("active"); pages[from].classList.add("flip-out"); }
    else{ pages[from].classList.remove("active"); pages[from].classList.add("hold"); pages[i].classList.add("active"); pages[i].classList.add("flip-in"); }
    pages[cur].scrollTop=0; runCounters();
    setTimeout(function(){ settle(); busy=false; }, 900);
  }
  function nxt(){ go(cur+1); }
  function prv(){ go(cur-1); }
  window.__deckNext=nxt; window.__deckPrev=prv; window.__deckGo=go;

  document.addEventListener("keydown",function(e){
    if(["ArrowRight","PageDown"," "].indexOf(e.key)>-1){ e.preventDefault(); nxt(); }
    else if(["ArrowLeft","PageUp"].indexOf(e.key)>-1){ e.preventDefault(); prv(); }
    else if(e.key==="Home"){ go(0); }
    else if(e.key==="End"){ go(total-1); }
  });

  var wheelLock=false;
  deck.addEventListener("wheel",function(e){
    var pg=pages[cur], canScroll=pg.scrollHeight>pg.clientHeight+2;
    if(canScroll){
      var atTop=pg.scrollTop<=0, atBot=pg.scrollTop+pg.clientHeight>=pg.scrollHeight-1;
      if(!(atTop && e.deltaY<0) && !(atBot && e.deltaY>0)) return;
    }
    if(wheelLock) return; if(Math.abs(e.deltaY)<12) return;
    wheelLock=true; if(e.deltaY>0) nxt(); else prv();
    setTimeout(function(){ wheelLock=false; }, 1000);
  },{passive:true});

  var sx=0,sy=0;
  deck.addEventListener("touchstart",function(e){ sx=e.changedTouches[0].clientX; sy=e.changedTouches[0].clientY; },{passive:true});
  deck.addEventListener("touchend",function(e){
    var dx=e.changedTouches[0].clientX-sx, dy=e.changedTouches[0].clientY-sy;
    if(Math.abs(dx)>55 && Math.abs(dx)>Math.abs(dy)){ if(dx<0) nxt(); else prv(); }
  },{passive:true});

  document.body.classList.add("light");
  document.getElementById("theme").addEventListener("click",function(){ document.body.classList.toggle("light"); });

  var toast=document.getElementById("toast"), toastMsg=document.getElementById("toastMsg"), toastTimer=null;
  function showToast(msg){ toastMsg.textContent=msg; toast.classList.add("show"); if(toastTimer) clearTimeout(toastTimer); toastTimer=setTimeout(function(){ toast.classList.remove("show"); },2600); }
  function shareLink(){
    var url=window.location.href.split("#")[0];
    var ta=document.createElement("textarea");
    ta.value=url; ta.setAttribute("readonly","");
    ta.style.position="fixed"; ta.style.top="-9999px"; ta.style.opacity="0";
    document.body.appendChild(ta); ta.focus(); ta.select();
    var ok=false; try{ ok=document.execCommand("copy"); }catch(e){ ok=false; }
    document.body.removeChild(ta);
    if(ok){ showToast("Link copied to clipboard"); } else { window.prompt("Copy this link:", url); }
  }
  window.__deckShare=shareLink;

  /* LinkedIn fallback: HTML viewers may intercept external links.
     The adjacent copy button always provides the exact profile URL. */
  var linkedInUrl="https://www.linkedin.com/in/darrenbartolome/";
  var copyLinkedIn=document.getElementById("copyLinkedIn");
  if(copyLinkedIn){
    copyLinkedIn.addEventListener("click",function(){
      var ta=document.createElement("textarea");
      ta.value=linkedInUrl; ta.setAttribute("readonly","");
      ta.style.position="fixed"; ta.style.top="-9999px"; ta.style.opacity="0";
      document.body.appendChild(ta); ta.focus(); ta.select();
      var ok=false; try{ ok=document.execCommand("copy"); }catch(e){ ok=false; }
      document.body.removeChild(ta);
      if(ok){ showToast("LinkedIn profile URL copied"); }
      else{ window.prompt("Copy LinkedIn profile URL:",linkedInUrl); }
    });
  }

  var reduce=window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  function runCounters(){
    var nums=pages[cur].querySelectorAll(".num[data-value]");
    if(!nums.length) return;
    nums.forEach(function(el){
      var target=Number(el.getAttribute("data-value"))||0;
      var suf=el.getAttribute("data-suffix")||"";
      var pre=el.getAttribute("data-prefix")||"";
      if(reduce){ el.textContent=pre+target+suf; return; }
      el.textContent=pre+"0"+suf;
      var dur=1300, delay=520, begin=null;
      function step(ts){
        if(begin===null) begin=ts;
        var t=ts-begin;
        if(t<delay){ requestAnimationFrame(step); return; }
        var p=Math.min((t-delay)/dur,1), e=1-Math.pow(1-p,3);
        el.textContent=pre+Math.round(target*e)+suf;
        if(p<1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    });
  }

  chrome();
  runCounters();
})();
</script>
