.cost-item .desc small{display:block;margin-top:2px;color:var(--faint);font-size:.74rem}

.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;width:100%;max-width:1240px;margin-inline:auto}
.metric{position:relative;overflow:hidden;padding:26px;min-height:180px;display:flex;flex-direction:column}
.metric.feature{background:linear-gradient(150deg,color-mix(in srgb,var(--a1) 16%,var(--panel-solid)),var(--panel-solid));border-color:var(--stroke-str)}
