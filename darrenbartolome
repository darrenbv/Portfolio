.proj-top{display:flex;align-items:center;justify-content:space-between;gap:12px}
.proj-badge{width:50px;height:50px;display:grid;place-items:center;border-radius:13px;font-weight:950;font-size:.76rem;background:linear-gradient(140deg,rgba(255,79,0,.16),rgba(255,150,80,.12));color:var(--a1)}
.proj-cat{font-size:.64rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--faint);text-align:right}
.proj h3{margin-top:18px;font-size:1.18rem;letter-spacing:-.02em}
.proj p{margin-top:10px;color:var(--soft);font-size:.86rem;flex:1}
.proj .impact{margin-top:16px;font-size:.82rem;font-weight:800;color:var(--a1)}
.proj .impact::before{content:"↗ "}
.proj .cost-tag{margin-top:10px;display:inline-flex;align-items:center;gap:8px;align-self:flex-start;padding:7px 13px;border-radius:999px;background:color-mix(in srgb,var(--a1) 14%,transparent);border:1px solid color-mix(in srgb,var(--a1) 30%,transparent);color:var(--a1);font-size:.76rem;font-weight:850;letter-spacing:.01em}
.proj .cost-tag svg{width:14px;height:14px;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round}

.timeline{width:100%;max-width:1240px;margin-inline:auto;position:relative;padding-left:34px}
.timeline::before{content:"";position:absolute;top:8px;bottom:8px;left:9px;width:2px;background:linear-gradient(var(--a1),var(--a2),var(--a3),transparent)}
.tl{position:relative;padding:16px 0;border-bottom:1px solid var(--stroke)}
.tl:last-child{border-bottom:0}
.tl::before{content:"";position:absolute;top:22px;left:-31px;width:12px;height:12px;border-radius:50%;background:var(--a1);box-shadow:0 0 0 4px var(--bg),var(--glow)}
