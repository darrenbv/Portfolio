.proj-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;width:100%;max-width:1240px;margin-inline:auto}
.proj{padding:26px;display:flex;flex-direction:column;transition:transform .25s var(--ease),border-color .25s ease}
