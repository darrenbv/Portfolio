.cost-hero{width:100%;max-width:1240px;margin:0 auto 20px;display:grid;grid-template-columns:1.15fr 1fr;gap:26px;align-items:center;padding:30px 32px;position:relative;overflow:hidden;border:1px solid var(--stroke-str)}
